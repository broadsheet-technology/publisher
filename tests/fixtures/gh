#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >> "$GH_CALL_LOG"

if [ "${1:-}" != "api" ]; then
  echo "unexpected gh command: $*" >&2
  exit 2
fi
shift

if [ "${1:-}" = "--method" ]; then
  if [ "${2:-}" != "DELETE" ] || [ -z "${3:-}" ]; then
    echo "unexpected gh api mutation: $*" >&2
    exit 2
  fi
  exit 0
fi

endpoint="${1:-}"
if [ "$endpoint" = "/users/$MOCK_OWNER" ]; then
  if [ "${MOCK_OWNER_LOOKUP:-success}" = "failure" ]; then
    echo '{"message":"owner lookup failed","status":"500"}'
    echo "gh: owner lookup failed (HTTP 500)" >&2
    exit 1
  fi
  printf '%s\n' "$MOCK_OWNER_TYPE"
  exit 0
fi

case "${MOCK_VERSION_LOOKUP:-success}" in
  success)
    printf '%s\n' "${MOCK_VERSION_ID:-123}"
    ;;
  missing-tag)
    ;;
  missing-package)
    echo '{"message":"Not Found","status":"404"}'
    echo "gh: Not Found (HTTP 404)" >&2
    exit 1
    ;;
  permission-error)
    echo '{"message":"Resource not accessible by integration","status":"403"}'
    echo "gh: Resource not accessible by integration (HTTP 403)" >&2
    exit 1
    ;;
  *)
    echo "unexpected MOCK_VERSION_LOOKUP: $MOCK_VERSION_LOOKUP" >&2
    exit 2
    ;;
esac
